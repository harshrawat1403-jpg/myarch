# TNPArch — Environment Variables
# Copy this file to .env.local for local development. Never commit real values.
# See docs/security/14_Security_Architecture.md and docs/architecture/06_Technology_Stack.md.

# --- Database ---------------------------------------------------------------
# Pooled PostgreSQL connection for runtime web and worker traffic.
DATABASE_URL="postgresql://user:password@localhost:5432/tnparch_dev"
# Direct PostgreSQL connection for Prisma migrations and administrative CLI commands.
DIRECT_URL="postgresql://user:password@localhost:5432/tnparch_dev"

# --- Auth ---------------------------------------------------------------
# Signing secret for short-lived access tokens (JWT). Generate a long, random value.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
# Signing secret for refresh tokens. Must differ from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
# Access token lifetime, e.g. "15m".
JWT_ACCESS_TTL="15m"
# Refresh token lifetime, e.g. "30d".
JWT_REFRESH_TTL="30d"
# bcrypt cost factor — must be 12 or higher per docs/security/14_Security_Architecture.md.
BCRYPT_COST_FACTOR="12"

# --- One-time production admin bootstrap ------------------------------------
# Used only by `npm run bootstrap:admin`. Set these securely in the command
# environment, run once, then remove them from the deployment environment.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# --- Object Storage (resumes, portfolio images, documents) -------------------
# `local` is the development default. Production uses `r2` and all S3 values below.
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_ROOT="storage/uploads"
# S3-compatible endpoint. Cloudflare R2 recommended — see docs/architecture/06_Technology_Stack.md.
# Provider selection remains an open decision (docs/planning/18_Open_Questions.md, Q1 is deployment;
# storage provider specifics are configured here regardless of final hosting choice).
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Email ---------------------------------------------------------------
# Provider is an open decision — docs/planning/18_Open_Questions.md (Q2).
# EMAIL_PROVIDER accepts: "console" (local/dev, logs instead of sending) | "resend" | "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM_ADDRESS="noreply@tnparch.in"
# Used only when EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Used only when EMAIL_PROVIDER="smtp" (e.g. a college mail server relay)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# --- Background Job Processing System ---------------------------------------
# Optional — sane defaults apply if unset. See src/modules/jobs.
JOB_WORKER_POLL_INTERVAL_MS="2000"
JOB_WORKER_BATCH_SIZE="5"

# --- Application ---------------------------------------------------------------
# Base URL of the deployed app, used to build links in emails.
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
