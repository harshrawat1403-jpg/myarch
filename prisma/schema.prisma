  configurationLockedBy       User?                          @relation("ElectionLocker", fields: [configurationLockedByUserId], references: [id], onDelete: Restrict)
  openedAt                    DateTime?
  closedAt                    DateTime?
  voterSnapshotLockedAt       DateTime?
  voterSnapshotLockedByUserId String?                        @db.Uuid
  voterSnapshotLockedBy       User?                          @relation("ElectionVoterSnapshotLocker", fields: [voterSnapshotLockedByUserId], references: [id], onDelete: Restrict)
  createdByUserId             String                         @db.Uuid
  createdBy                   User                           @relation("ElectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  positions                   ElectionPosition[]
  applicationForm             ElectionApplicationForm?
  candidates                  ElectionCandidate[]
  scrutinyReviews             ElectionScrutinyReview[]
  correctionRequests          ElectionCorrectionRequest[]
  objections                  ElectionObjection[]
  shortlistEntries            ElectionShortlistEntry[]
  interviewCriteria           ElectionInterviewCriterion[]
  interviews                  ElectionInterview[]
  finalCandidates             ElectionFinalCandidate[]
  facultyRosterEntries        ElectionFacultyRosterEntry[]
  exCouncilRosterEntries      ElectionExCouncilRosterEntry[]
  voterSnapshots              ElectionVoterSnapshot[]
  voterParticipations         ElectionVoterParticipation[]
  ballots                     ElectionBallot[]
  resultSnapshots             ElectionResultSnapshot[]

  @@index([status, applicationOpenAt, applicationCloseAt])
  @@index([academicYear, type])
  @@map("elections")
}

model ElectionPosition {
  id               String                      @id @default(uuid()) @db.Uuid
  electionId       String                      @db.Uuid
  election         Election                    @relation(fields: [electionId], references: [id], onDelete: Restrict)
  title            String
  identityKey      String
  description      String
  seats            Int
  displayOrder     Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  weights          ElectionPositionWeight[]
  candidates       ElectionCandidatePosition[]
  shortlistEntries ElectionShortlistEntry[]
  interviews       ElectionInterview[]
  finalCandidates  ElectionFinalCandidate[]
  ballotChoices    ElectionBallotChoice[]
  resultPositions  ElectionPositionResult[]

  @@unique([electionId, identityKey])
  @@unique([id, electionId])
  @@index([electionId, displayOrder])
  @@map("election_positions")
}

model ElectionPositionWeight {
  id         String             @id @default(uuid()) @db.Uuid
  positionId String             @db.Uuid
  position   ElectionPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  voterGroup ElectionVoterGroup
  percentage Decimal            @db.Decimal(5, 2)

  @@unique([positionId, voterGroup])
  @@map("election_position_weights")
}

model ElectionApplicationForm {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @unique @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  formId     String   @unique @db.Uuid
  form       Form     @relation(fields: [formId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@map("election_application_forms")
}

model ElectionCandidate {
  id                 String                      @id @default(uuid()) @db.Uuid
  electionId         String                      @db.Uuid
  election           Election                    @relation(fields: [electionId], references: [id], onDelete: Restrict)
  applicationId      String                      @unique @db.Uuid
  application        FormApplication             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicantUserId    String                      @db.Uuid
  applicant          User                        @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)
  status             ElectionCandidateStatus     @default(APPLIED)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  positions          ElectionCandidatePosition[]
  scrutinyReviews    ElectionScrutinyReview[]
  correctionRequests ElectionCorrectionRequest[]
  objections         ElectionObjection[]
  shortlistEntries   ElectionShortlistEntry[]
  interviews         ElectionInterview[]
  finalCandidates    ElectionFinalCandidate[]
  ballotChoices      ElectionBallotChoice[]
  resultEntries      ElectionCandidateResult[]

  @@unique([electionId, applicantUserId])
  @@unique([id, electionId])
  @@index([applicantUserId])
  @@map("election_candidates")
}

model ElectionCandidatePosition {
  id          String            @id @default(uuid()) @db.Uuid
  electionId  String            @db.Uuid
  candidateId String            @db.Uuid
  candidate   ElectionCandidate @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  positionId  String            @db.Uuid
  position    ElectionPosition  @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)

  @@unique([candidateId, positionId])
  @@index([positionId, electionId])
  @@map("election_candidate_positions")
}

model ElectionScrutinyReview {
  id             String                   @id @default(uuid()) @db.Uuid
  electionId     String                   @db.Uuid
  election       Election                 @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId    String                   @db.Uuid
  candidate      ElectionCandidate        @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  decision       ElectionScrutinyDecision
  reason         String
  reviewerUserId String                   @db.Uuid
  reviewer       User                     @relation("ElectionScrutinyReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())

  @@index([candidateId, createdAt])
  @@index([electionId, decision])
  @@map("election_scrutiny_reviews")
}

model ElectionCorrectionRequest {
  id                String                         @id @default(uuid()) @db.Uuid
  electionId        String                         @db.Uuid
  election          Election                       @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId       String                         @db.Uuid
  candidate         ElectionCandidate              @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  instructions      String
  status            ElectionCorrectionStatus       @default(OPEN)
  requestedByUserId String                         @db.Uuid
  requestedBy       User                           @relation("ElectionCorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  resolvedAt        DateTime?
  createdAt         DateTime                       @default(now())
  submissions       ElectionCorrectionSubmission[]

  @@index([candidateId, status])
  @@index([electionId, status])
  @@map("election_correction_requests")
}

model ElectionCorrectionSubmission {
  id                  String                    @id @default(uuid()) @db.Uuid
  correctionRequestId String                    @unique @db.Uuid
  correctionRequest   ElectionCorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  submittedByUserId   String                    @db.Uuid
  submittedBy         User                      @relation("ElectionCorrectionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  statement           String
  evidenceReference   String?
  createdAt           DateTime                  @default(now())

  @@map("election_correction_submissions")
}

model ElectionObjection {
  id                String                  @id @default(uuid()) @db.Uuid
  electionId        String                  @db.Uuid
  election          Election                @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId       String                  @db.Uuid
  candidate         ElectionCandidate       @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  objectorUserId    String                  @db.Uuid
  objector          User                    @relation("ElectionObjectionObjector", fields: [objectorUserId], references: [id], onDelete: Restrict)
  reason            String
  evidenceReference String?
  status            ElectionObjectionStatus @default(OPEN)
  reviewedByUserId  String?                 @db.Uuid
  reviewedBy        User?                   @relation("ElectionObjectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  decisionReason    String?
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())

  @@index([candidateId, status])
  @@index([electionId, status])
  @@map("election_objections")
}

model ElectionShortlistEntry {
  id                  String            @id @default(uuid()) @db.Uuid
  electionId          String            @db.Uuid
  election            Election          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId         String            @db.Uuid
  candidate           ElectionCandidate @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  positionId          String            @db.Uuid
  position            ElectionPosition  @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)
  shortlistedByUserId String            @db.Uuid
  shortlistedBy       User              @relation("ElectionShortlistActor", fields: [shortlistedByUserId], references: [id], onDelete: Restrict)
  shortlistedAt       DateTime          @default(now())

  @@unique([candidateId, positionId])
  @@index([electionId, positionId])
  @@map("election_shortlist_entries")
}

model ElectionInterviewCriterion {
  id           String                   @id @default(uuid()) @db.Uuid
  electionId   String                   @db.Uuid
  election     Election                 @relation(fields: [electionId], references: [id], onDelete: Restrict)
  name         String
  description  String
  maxScore     Decimal                  @db.Decimal(7, 2)
  weight       Decimal                  @default(1) @db.Decimal(7, 2)
  displayOrder Int
  required     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  scores       ElectionInterviewScore[]

  @@unique([electionId, displayOrder])
  @@index([electionId])
  @@map("election_interview_criteria")
}

model ElectionInterview {
  id                String                         @id @default(uuid()) @db.Uuid
  electionId        String                         @db.Uuid
  election          Election                       @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId       String                         @db.Uuid
  candidate         ElectionCandidate              @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  positionId        String                         @db.Uuid
  position          ElectionPosition               @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)
  status            ElectionInterviewStatus        @default(PLANNED)
  scheduledAt       DateTime?
  durationMinutes   Int?
  mode              String?
  location          String?
  candidateAttended Boolean?
  completedAt       DateTime?
  scoresLockedAt    DateTime?
  scheduledByUserId String                         @db.Uuid
  scheduledBy       User                           @relation("ElectionInterviewScheduler", fields: [scheduledByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  panelMembers      ElectionInterviewPanelMember[]
  scores            ElectionInterviewScore[]

  @@unique([candidateId, positionId])
  @@index([electionId, status, scheduledAt])
  @@map("election_interviews")
}

model ElectionInterviewPanelMember {
  id                 String                   @id @default(uuid()) @db.Uuid
  interviewId        String                   @db.Uuid
  interview          ElectionInterview        @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  userId             String                   @db.Uuid
  user               User                     @relation("ElectionPanelMember", fields: [userId], references: [id], onDelete: Restrict)
  panelRole          String?
  conflictDeclaredAt DateTime?
  isRecused          Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  scores             ElectionInterviewScore[]

  @@unique([interviewId, userId])
  @@index([userId, isRecused])
  @@map("election_interview_panel_members")
}

model ElectionInterviewScore {
  id            String                       @id @default(uuid()) @db.Uuid
  interviewId   String                       @db.Uuid
  interview     ElectionInterview            @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  panelMemberId String                       @db.Uuid
  panelMember   ElectionInterviewPanelMember @relation(fields: [panelMemberId], references: [id], onDelete: Restrict)
  criterionId   String                       @db.Uuid
  criterion     ElectionInterviewCriterion   @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  score         Decimal                      @db.Decimal(7, 2)
  comments      String?
  submittedAt   DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([interviewId, panelMemberId, criterionId])
  @@index([interviewId])
  @@map("election_interview_scores")
}

model ElectionFinalCandidate {
  id             String            @id @default(uuid()) @db.Uuid
  electionId     String            @db.Uuid
  election       Election          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId    String            @db.Uuid
  candidate      ElectionCandidate @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  positionId     String            @db.Uuid
  position       ElectionPosition  @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)
  lockedByUserId String            @db.Uuid
  lockedBy       User              @relation("ElectionFinalCandidateLocker", fields: [lockedByUserId], references: [id], onDelete: Restrict)
  lockedAt       DateTime          @default(now())

  @@unique([candidateId, positionId])
  @@index([electionId, positionId])
  @@map("election_final_candidates")
}

// Council-only eligibility is explicit. Faculty and former Council membership
// are never inferred from a generic account role or committee history.
model ElectionFacultyRosterEntry {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  userId     String   @db.Uuid
  user       User     @relation("ElectionFacultyRosterUser", fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([electionId, userId])
  @@index([userId])
  @@map("election_faculty_roster_entries")
}

model ElectionExCouncilRosterEntry {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  userId     String   @db.Uuid
  user       User     @relation("ElectionExCouncilRosterUser", fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([electionId, userId])
  @@index([userId])
  @@map("election_ex_council_roster_entries")
}

// Identity-bearing records intentionally have no relation to ballots or
// choices. They prove eligibility and prevent repeat participation only.
model ElectionVoterSnapshot {
  id         String             @id @default(uuid()) @db.Uuid
  electionId String             @db.Uuid
  election   Election           @relation(fields: [electionId], references: [id], onDelete: Restrict)
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  voterGroup ElectionVoterGroup
  createdAt  DateTime           @default(now())

  @@unique([electionId, userId])
  @@unique([id, electionId])
  @@index([electionId, voterGroup])
  @@map("election_voter_snapshots")
}

model ElectionVoterParticipation {
  id          String                      @id @default(uuid()) @db.Uuid
  electionId  String                      @db.Uuid
  election    Election                    @relation(fields: [electionId], references: [id], onDelete: Restrict)
  userId      String                      @db.Uuid
  user        User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      ElectionParticipationStatus
  submittedAt DateTime                    @default(now())

  @@unique([electionId, userId])
  @@index([electionId, status])
  @@map("election_voter_participations")
}

// A ballot has no voter identifier and ElectionVoterParticipation has no
// ballot identifier. The database therefore has no voter-to-choice join path.
model ElectionBallot {
  id         String                 @id @default(uuid()) @db.Uuid
  electionId String                 @db.Uuid
  election   Election               @relation(fields: [electionId], references: [id], onDelete: Restrict)
  castAt     DateTime               @default(now())
  // Copied from the locked snapshot without any voter identifier or relation.
  voterGroup ElectionVoterGroup?
  choices    ElectionBallotChoice[]

  @@unique([id, electionId])
  @@index([electionId, castAt])
  @@index([electionId, voterGroup])
  @@map("election_ballots")
}

// Council result records are aggregate-only snapshots. They intentionally
// have no relation to ElectionVoterParticipation or User voters.
model ElectionResultSnapshot {
  id                 String                            @id @default(uuid()) @db.Uuid
  electionId         String                            @db.Uuid
  election           Election                          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  version            Int
  status             ElectionResultStatus
  countedAt          DateTime                          @default(now())
  countedByUserId    String                            @db.Uuid
  countedBy          User                              @relation("ElectionResultCounter", fields: [countedByUserId], references: [id], onDelete: Restrict)
  positions          ElectionPositionResult[]
  verifierAssignment ElectionResultVerifierAssignment?
  verification       ElectionResultVerification?
  certification      ElectionCertification?
  publication        ElectionResultPublication?
  appointments       ElectionAppointment[]

  @@unique([electionId, version])
  @@unique([id, electionId])
  @@index([electionId, countedAt])
  @@map("election_result_snapshots")
}

model ElectionPositionResult {
  id             String                        @id @default(uuid()) @db.Uuid
  snapshotId     String                        @db.Uuid
  snapshot       ElectionResultSnapshot        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  electionId     String                        @db.Uuid
  positionId     String                        @db.Uuid
  position       ElectionPosition              @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)
  positionTitle  String
  status         ElectionPositionResultStatus
  notaFinalScore Decimal                       @default(0) @db.Decimal(24, 18)
  groups         ElectionPositionGroupResult[]
  candidates     ElectionCandidateResult[]
  appointment    ElectionAppointment?

  @@unique([snapshotId, positionId])
  @@unique([id, snapshotId, electionId])
  @@index([electionId, positionId])
  @@map("election_position_results")
}

model ElectionPositionGroupResult {
  id                  String                         @id @default(uuid()) @db.Uuid
  positionResultId    String                         @db.Uuid
  positionResult      ElectionPositionResult         @relation(fields: [positionResultId], references: [id], onDelete: Restrict)
  voterGroup          ElectionVoterGroup
  eligibleCount       Int
  participationCount  Int
  abstentionCount     Int
  notaVoteCount       Int
  scoringDenominator  Int
  quorumPercent       Decimal                        @db.Decimal(5, 2)
  quorumMet           Boolean
  configuredWeight    Decimal                        @db.Decimal(5, 2)
  notaNormalizedScore Decimal                        @default(0) @db.Decimal(24, 18)
  candidateScores     ElectionCandidateGroupResult[]

  @@unique([positionResultId, voterGroup])
  @@map("election_position_group_results")
}

model ElectionCandidateResult {
  id                  String                         @id @default(uuid()) @db.Uuid
  positionResultId    String                         @db.Uuid
  positionResult      ElectionPositionResult         @relation(fields: [positionResultId], references: [id], onDelete: Restrict)
  electionId          String                         @db.Uuid
  candidateId         String                         @db.Uuid
  candidate           ElectionCandidate              @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  candidateName       String
  rawRank             Int
  isProvisionalWinner Boolean                        @default(false)
  finalScore          Decimal                        @db.Decimal(24, 18)
  groups              ElectionCandidateGroupResult[]

  @@unique([positionResultId, candidateId])
  @@index([candidateId])
  @@map("election_candidate_results")
}

model ElectionCandidateGroupResult {
  id                    String                      @id @default(uuid()) @db.Uuid
  candidateResultId     String                      @db.Uuid
  candidateResult       ElectionCandidateResult     @relation(fields: [candidateResultId], references: [id], onDelete: Restrict)
  positionGroupResultId String                      @db.Uuid
  positionGroupResult   ElectionPositionGroupResult @relation(fields: [positionGroupResultId], references: [id], onDelete: Restrict)
  rawVoteCount          Int
  normalizedScore       Decimal                     @db.Decimal(24, 18)

  @@unique([candidateResultId, positionGroupResultId])
  @@map("election_candidate_group_results")
}

model ElectionResultVerifierAssignment {
  id               String                      @id @default(uuid()) @db.Uuid
  electionId       String                      @db.Uuid
  snapshotId       String                      @db.Uuid
  snapshot         ElectionResultSnapshot      @relation(fields: [snapshotId, electionId], references: [id, electionId], onDelete: Restrict)
  verifierUserId   String                      @db.Uuid
  verifier         User                        @relation("ElectionResultVerifier", fields: [verifierUserId], references: [id], onDelete: Restrict)
  assignedByUserId String                      @db.Uuid
  assignedBy       User                        @relation("ElectionResultVerifierAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime                    @default(now())
  verification     ElectionResultVerification?

  @@unique([electionId])
  @@unique([snapshotId])
  @@unique([snapshotId, electionId])
  @@index([verifierUserId])
  @@map("election_result_verifier_assignments")
}

model ElectionResultVerification {
  id             String                           @id @default(uuid()) @db.Uuid
  electionId     String                           @db.Uuid
  snapshotId     String                           @db.Uuid
  snapshot       ElectionResultSnapshot           @relation(fields: [snapshotId, electionId], references: [id, electionId], onDelete: Restrict)
  assignmentId   String                           @unique @db.Uuid
  assignment     ElectionResultVerifierAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  verifierUserId String                           @db.Uuid
  verifier       User                             @relation("ElectionResultVerifier", fields: [verifierUserId], references: [id], onDelete: Restrict)
  outcome        ElectionVerificationOutcome
  note           String?
  finalizedAt    DateTime                         @default(now())

  @@unique([snapshotId])
  @@unique([snapshotId, electionId])
  @@index([electionId, finalizedAt])
  @@map("election_result_verifications")
}

model ElectionCertification {
  id                String                 @id @default(uuid()) @db.Uuid
  electionId        String                 @db.Uuid
  snapshotId        String                 @db.Uuid
  snapshot          ElectionResultSnapshot @relation(fields: [snapshotId, electionId], references: [id, electionId], onDelete: Restrict)
  certifiedByUserId String                 @db.Uuid
  certifiedBy       User                   @relation("ElectionResultCertifier", fields: [certifiedByUserId], references: [id], onDelete: Restrict)
  note              String?
  certifiedAt       DateTime               @default(now())

  @@unique([snapshotId])
  @@unique([snapshotId, electionId])
  @@index([electionId, certifiedAt])
  @@map("election_certifications")
}

model ElectionResultPublication {
  id                String                 @id @default(uuid()) @db.Uuid
  electionId        String                 @db.Uuid
  snapshotId        String                 @db.Uuid
  snapshot          ElectionResultSnapshot @relation(fields: [snapshotId, electionId], references: [id, electionId], onDelete: Restrict)
  publishedByUserId String                 @db.Uuid
  publishedBy       User                   @relation("ElectionResultPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  publishedAt       DateTime               @default(now())

  @@unique([snapshotId])
  @@unique([snapshotId, electionId])
  @@index([electionId, publishedAt])
  @@map("election_result_publications")
}

model ElectionAppointment {
  id                String                 @id @default(uuid()) @db.Uuid
  electionId        String                 @db.Uuid
  snapshotId        String                 @db.Uuid
  snapshot          ElectionResultSnapshot @relation(fields: [snapshotId, electionId], references: [id, electionId], onDelete: Restrict)
  positionResultId  String                 @unique @db.Uuid
  positionResult    ElectionPositionResult @relation(fields: [positionResultId, snapshotId, electionId], references: [id, snapshotId, electionId], onDelete: Restrict)
  appointedUserId   String                 @db.Uuid
  appointedUser     User                   @relation("ElectionAppointmentUser", fields: [appointedUserId], references: [id], onDelete: Restrict)
  committeeId       String                 @db.Uuid
  committee         Committee              @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  membershipId      String                 @unique @db.Uuid
  membership        CommitteeMembership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  confirmedByUserId String                 @db.Uuid
  confirmedBy       User                   @relation("ElectionAppointmentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  appointedAt       DateTime               @default(now())

  @@unique([electionId, positionResultId])
  @@unique([positionResultId, snapshotId, electionId])
  @@index([electionId, snapshotId])
  @@map("election_appointments")
}

model ElectionBallotChoice {
  id          String             @id @default(uuid()) @db.Uuid
  ballotId    String             @db.Uuid
  electionId  String             @db.Uuid
  ballot      ElectionBallot     @relation(fields: [ballotId, electionId], references: [id, electionId], onDelete: Restrict)
  positionId  String             @db.Uuid
  position    ElectionPosition   @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Restrict)
  candidateId String?            @db.Uuid
  candidate   ElectionCandidate? @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)
  isNota      Boolean            @default(false)

  @@unique([ballotId, positionId])
  @@index([electionId, positionId])
  @@map("election_ballot_choices")
}
