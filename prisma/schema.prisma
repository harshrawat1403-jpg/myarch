  DRAFT
  APPLICATION_OPEN
  APPLICATION_CLOSED
  SCRUTINY
  CORRECTIONS
  SHORTLIST
  INTERVIEWS
  COUNCIL_REVIEW
  SELECTION_DECIDED
  PUBLISHED
  MEMBERSHIP_CONFIRMED
  ARCHIVED
}

enum CoreCommitteeSelectionCandidateStatus {
  APPLIED
  ELIGIBLE
  INELIGIBLE
  CORRECTION_REQUIRED
  SHORTLISTED
  WITHDRAWN
}

enum CoreCommitteeSelectionCorrectionStatus {
  OPEN
  SUBMITTED
  RESOLVED
  CANCELLED
}

enum CoreCommitteeSelectionInterviewStatus {
  PLANNED
