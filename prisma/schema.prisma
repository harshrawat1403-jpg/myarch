// TNPArch — Prisma Schema
//
// This schema implements the Phase 1 (MVP) subset of the data model defined in
// docs/database/08_Database_Design.md. It is the authoritative, frozen data
// model per Day 1 of docs/planning/16_Project_Roadmap.md — changes to this
// file are architecture changes and require the same approval as any other
// change to docs/database/08_Database_Design.md.
//
// Phase 2+ entities (Company, PlacementDrive, Application, ApplicationStatusEvent)
// are intentionally NOT implemented yet — they are explicitly scoped to Phase 2
// in the database design doc, and adding them now would be building ahead of
// what Phase 1 requires. RecruiterProfile has no company relation yet for the
// same reason; docs/database/08_Database_Design.md's ER overview shows that
// relation, but it is only load-bearing once Company/PlacementDrive exist in
// Phase 2, so it is deferred to that phase's migration rather than added as
// dead schema now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// MYARCH Phase 1: ALUMNI added for self-service alumni signup (see
// AlumniProfile.userId/approvalStatus below). Purely additive — existing
// values/ordinal positions unchanged, so this is a safe `ALTER TYPE ...
// ADD VALUE` migration with no risk to existing rows. Unrelated to
// CoordinatorPosition's own "ALUMNI" value below (the Alumni Coordinator
// *position* label) — distinct Postgres enum types, never interchangeable
// at the TypeScript level either.
enum Role {
  SECRETARY
  COORDINATOR
  STUDENT
  RECRUITER
  ALUMNI
}

// MYARCH Phase 2 (§3.8) — the reusable Task/Follow-up Engine.
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// MYARCH Phase 2 (§3.1/§3.7) — Maintenance & Generic Requests.
enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  FURNITURE
  HVAC
  NETWORK
  CLASSROOM_STUDIO
  LAB
  EQUIPMENT
  CLEANING
  SAFETY
  CIVIL_BUILDING
  OTHER
}

enum MaintenanceIssueStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
}

enum RequestStatus {
  SUBMITTED
  REVIEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum RequestDecision {
  APPROVED
  REJECTED
}

// MYARCH Phase 3 (§4.2/§4.4/§4.5) — Events, Meetings, Announcements.
enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum EventParticipantRole {
  ORGANIZER
  COORDINATOR
  VOLUNTEER
}

enum EventAttachmentKind {
  DOCUMENT
  MEDIA
}

enum EventFormKind {
  REGISTRATION
  VOLUNTEER
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AnnouncementAudienceType {
  EVERYONE
  YEAR
  PROGRAM
  COMMITTEE
  COUNCIL
  COORDINATORS
  SELECTED_GROUP
}

enum BatchStatus {
  ACTIVE
  GRADUATED
  ARCHIVED
}

// MYARCH Phase 4 (§5) — Council & Committees. One unified model covers every
// named group (Student Council, Core Committee, Event/Technical committees,
// project teams, temporary committees) — they all share the identical
// attribute shape per the roadmap's own spec, mirroring how CoordinatorPosition
// unifies T&P/Alumni/Technical/Other rather than one table per variant.
enum CommitteeType {
  STUDENT_COUNCIL
  CORE_COMMITTEE
  EVENT_COMMITTEE
  TECHNICAL_COMMITTEE
  PROJECT_TEAM
  TEMPORARY_COMMITTEE
}

// ARCHIVED covers both a rotated-out Student Council/Core Committee and a
// finished temporary/event committee — never deleted, mirroring Batch's own
// never-delete/status-flip precedent (§5's "preserve historical membership /
// do not destroy previous-year records").
enum CommitteeStatus {
  ACTIVE
  ARCHIVED
}

// Renamed from the original REJECTED per the Days 5-6 implementation
// decision (approved by the Secretary): "Submitted" is a transient action,
// not a stored state (DRAFT/CHANGES_REQUESTED -> PENDING_REVIEW), and the
// terminal-sounding REJECTED is renamed to CHANGES_REQUESTED to reflect that
// it is a non-terminal state a draft cycles back out of, not a dead end.
// See docs/database/08_Database_Design.md (still documents REJECTED — this
// is a known, deliberate, approved divergence; see CHANGELOG for the date
// and reasoning) and docs/planning/16_Project_Roadmap.md Days 5-6.
enum ProfileDraftStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum FileClassification {
  PRIVATE
  PUBLIC
}

enum NotificationChannel {
  EMAIL
  // V4.0 E1 — the concrete backing for the notification bell SheetLayout's
  // header already reserved (previously a literal "not yet available"
  // placeholder). Additive; existing EMAIL rows/behavior untouched.
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Extended for the generic Background Job Processing System (2026-08-05,
// see CHANGELOG). RUNNING/COMPLETE renamed to PROCESSING/COMPLETED, and
// RETRYING/CANCELLED added, to support the job worker's full lifecycle
// (retry/backoff, dead-lettering, cancellation). docs/database/08_Database_Design.md
// still documents the original 4-value PENDING/RUNNING/COMPLETE/FAILED —
// this is a known, deliberate, approved divergence (the Job table had zero
// production usage before this change, so nothing depended on the old
// values; see CHANGELOG for full reasoning), same pattern as the Days 5-6
// ProfileDraftStatus rename.
enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

// V3.0 Administration Platform. A Secretary-created recruiter is
// pre-approved (creating one directly *is* the approval) — PENDING exists
// for a future public recruiter-signup path, not built yet, so this status
// is ready without a fabricated signup flow ahead of it.
enum RecruiterApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// V4.0 B1: SUBMITTED → (REVIEWED | NEEDS_ATTENTION, Coordinator, non-final)
// → (APPROVED | REJECTED, Secretary, final — Q1). Coordinator's mark is
// advisory context for the Secretary's decision, not a gate.
enum RegistrationRequestStatus {
  SUBMITTED
  REVIEWED
  NEEDS_ATTENTION
  APPROVED
  REJECTED
}

// V4.0 (A1) + MYARCH unified Coordinator Position system: display/reporting
// label only — no value here is ever read by any permission function; only
// ever branch on `role === "COORDINATOR"`. Authorization for the Maintenance
// functional hierarchy is driven entirely by CoordinatorProfile.maintenanceRole
// (a separate field, unchanged by this enum), never by this one — MAINTENANCE_
// SECRETARY/MAINTENANCE_COORDINATOR were deliberately NOT added as values here
// to avoid two fields representing the same fact. T_AND_P/ALUMNI are legacy
// values, preserved for existing data and no longer offered to new Coordinators
// (superseded by TECHNICAL/OTHER) — never removed, never backfilled/rewritten.
// OTHER pairs with CoordinatorProfile.customPosition (its free-text label,
// e.g. "Cultural Coordinator"); customPosition is meaningless for every other
// value and MUST be null/ignored whenever position is not OTHER.
enum CoordinatorPosition {
  T_AND_P
  ALUMNI
  TECHNICAL
  OTHER
}

// MYARCH — Maintenance functional hierarchy (architecture amendment, not a
// new Role). A Coordinator flagged MAINTENANCE_SECRETARY administers the
// Maintenance domain (full maintenance.* access, plus the narrow power to
// edit the designated MAINTENANCE_COORDINATOR's own maintenance.* subset);
// MAINTENANCE_COORDINATOR is the operational role beneath them, receiving
// only delegated maintenance.* permissions like any other Coordinator.
// Both remain Role = COORDINATOR and both count toward the existing
// max-2-active-Coordinators cap — see MAX_ACTIVE_MAINTENANCE_SECRETARIES/
// MAX_ACTIVE_MAINTENANCE_COORDINATORS in coordinators/domain/entities.ts
// for the (application-layer-enforced, mirroring MAX_ACTIVE_COORDINATORS's
// own pattern) at-most-one-of-each invariant. Never read by any
// permission function outside src/modules/coordinators and
// src/modules/maintenance — this is deliberately NOT a Super Admin and
// must never be treated as unconditional access elsewhere.
enum MaintenanceCoordinatorRole {
  MAINTENANCE_SECRETARY
  MAINTENANCE_COORDINATOR
}

enum BulkRunStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum AcademicYearTransitionStatus {
  DRAFT
  PENDING_CONFIRMATION
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  createdElections               Election[]                         @relation("ElectionCreator")
  lockedElections                Election[]                         @relation("ElectionLocker")
  electionCandidacies            ElectionCandidate[]
  electionScrutinyReviews        ElectionScrutinyReview[]           @relation("ElectionScrutinyReviewer")
  electionCorrectionRequests     ElectionCorrectionRequest[]        @relation("ElectionCorrectionRequester")
  electionCorrectionSubmissions  ElectionCorrectionSubmission[]     @relation("ElectionCorrectionSubmitter")
  electionObjections             ElectionObjection[]                @relation("ElectionObjectionObjector")
  reviewedElectionObjections     ElectionObjection[]                @relation("ElectionObjectionReviewer")
  electionInterviewPanels        ElectionInterviewPanelMember[]     @relation("ElectionPanelMember")
  scheduledElectionInterviews    ElectionInterview[]                @relation("ElectionInterviewScheduler")
  lockedElectionFinalCandidates  ElectionFinalCandidate[]           @relation("ElectionFinalCandidateLocker")
  electionFacultyRosterEntries   ElectionFacultyRosterEntry[]       @relation("ElectionFacultyRosterUser")
  electionExCouncilRosterEntries ElectionExCouncilRosterEntry[]     @relation("ElectionExCouncilRosterUser")
  electionVoterSnapshots         ElectionVoterSnapshot[]
  electionVoterParticipations    ElectionVoterParticipation[]
  lockedElectionVoterSnapshots   Election[]                         @relation("ElectionVoterSnapshotLocker")
  countedElectionResults         ElectionResultSnapshot[]           @relation("ElectionResultCounter")
  assignedElectionVerifications  ElectionResultVerifierAssignment[] @relation("ElectionResultVerifier")
  assignedElectionVerifiers      ElectionResultVerifierAssignment[] @relation("ElectionResultVerifierAssigner")
  completedElectionVerifications ElectionResultVerification[]       @relation("ElectionResultVerifier")
  certifiedElectionResults       ElectionCertification[]            @relation("ElectionResultCertifier")
  publishedElectionResults       ElectionResultPublication[]        @relation("ElectionResultPublisher")
  confirmedElectionAppointments  ElectionAppointment[]              @relation("ElectionAppointmentConfirmer")
  appointedThroughElections      ElectionAppointment[]              @relation("ElectionAppointmentUser")
  shortlistedElectionEntries     ElectionShortlistEntry[]           @relation("ElectionShortlistActor")
  id                             String                             @id @default(uuid()) @db.Uuid
  email                          String                             @unique
  passwordHash                   String
  role                           Role
  isActive                       Boolean                            @default(true)
  createdAt                      DateTime                           @default(now())
  updatedAt                      DateTime                           @updatedAt

  // V3.0 Administration Platform: set true whenever an admin issues a
  // temporary password (account creation or reset) — see
  // src/modules/auth/application/use-cases/admin-reset-password.ts. Cleared
  // only by ChangeOwnPasswordUseCase, never by an admin action, so a forced
  // change can't be silently bypassed by someone other than the account
  // holder proving they know the temp password.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  // MYARCH Phase 1: null until the account's email has been verified via a
  // consumed EmailVerificationToken. Only meaningful for self-signup roles
  // (RECRUITER, ALUMNI) whose login is separately gated by `isActive`
  // staying false until admin approval — see SignupRecruiterUseCase/
  // SignupAlumniUseCase. Admin-provisioned accounts (Coordinator, admin-
  // created Recruiter, Secretary, and Student-via-registration-approval)
  // are stamped verified at creation time — the department already vouches
  // for those addresses, so there is nothing to separately verify.
  emailVerifiedAt DateTime?

  // V3.0 Account Settings: an optional profile photo, stored via the same
  // FileAsset metadata table every other upload uses (classification
  // PUBLIC — nothing sensitive about an account's own avatar). Nullable:
  // most accounts never set one.
  avatarFileId String?    @unique @db.Uuid
  avatar       FileAsset? @relation("UserAvatar", fields: [avatarFileId], references: [id])

  secretaryProfile   SecretaryProfile?
  coordinatorProfile CoordinatorProfile?
  studentProfile     StudentProfile?
  recruiterProfile   RecruiterProfile?
  alumniProfile      AlumniProfile?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Reverse relations for audit/traceability — who last touched a record.
  updatedPrivateProfiles       StudentPrivateProfile[]     @relation("PrivateProfileUpdatedBy")
  reviewedDrafts               StudentPublicProfileDraft[] @relation("DraftReviewedBy")
  publishedProfiles            StudentPublicProfile[]      @relation("ProfilePublishedBy")
  uploadedFiles                FileAsset[]                 @relation("FileOwner")
  auditLogEntries              AuditLog[]                  @relation("AuditActor")
  notifications                Notification[]              @relation("NotificationRecipient")
  bulkImportRuns               BulkImportRun[]             @relation("BulkImportRunActor")
  academicYearTransitionRuns   AcademicYearTransitionRun[] @relation("AcademicYearTransitionRunActor")
  reviewedRegistrationRequests RegistrationRequest[]       @relation("RegistrationRequestReviewedBy")
  decidedRegistrationRequests  RegistrationRequest[]       @relation("RegistrationRequestDecidedBy")
  createdPlacementDrives       PlacementDrive[]            @relation("PlacementDriveCreatedBy")
  applicationStatusChanges     ApplicationStatusEvent[]    @relation("ApplicationStatusChangedBy")
  createdPublicationTemplates  PublicationTemplate[]       @relation("PublicationTemplateCreatedBy")
  createdPublications          Publication[]               @relation("PublicationCreatedBy")
  lastEditedPublications       Publication[]               @relation("PublicationLastEditedBy")
  createdPublicationVersions   PublicationVersion[]        @relation("PublicationVersionCreatedBy")
  generatedPublicationExports  PublicationExport[]         @relation("PublicationExportGeneratedBy")

  // MYARCH Phase 2 (§3.8) — Task/Follow-up Engine.
  tasksOwned         Task[]        @relation("TaskOwner")
  tasksCreated       Task[]        @relation("TaskCreator")
  tasksEscalatedToMe Task[]        @relation("TaskEscalatedTo")
  taskComments       TaskComment[] @relation("TaskCommentAuthor")

  // MYARCH Phase 2 (§3.1–§3.7) — Maintenance & Generic Requests.
  maintenanceIssuesReported MaintenanceIssue[] @relation("MaintenanceIssueRequester")
  maintenanceIssuesAssigned MaintenanceIssue[] @relation("MaintenanceIssueAssignee")
  requestsSubmitted         Request[]          @relation("RequestRequester")
  requestsOwned             Request[]          @relation("RequestOwner")

  // MYARCH Phase 3 (§4.1–§4.5) — Calendar, Events & Meetings.
  eventsOrganized       Event[]                 @relation("EventOrganizer")
  eventParticipations   EventParticipant[]      @relation("EventParticipantUser")
  eventRegistrations    EventRegistration[]     @relation("EventRegistrationUser")
  uploadedEventGalleryItems EventGalleryItem[]  @relation("EventGalleryUploader")
  meetingsOrganized     Meeting[]               @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]    @relation("MeetingParticipantUser")
  announcementsAuthored Announcement[]          @relation("AnnouncementAuthor")
  announcementRecipient AnnouncementRecipient[] @relation("AnnouncementRecipientUser")

  // MYARCH Phase 4 (§5) — Council & Committees.
  committeeMemberships CommitteeMembership[] @relation("CommitteeMembershipUser")

  // MYARCH Phase 5 — Generic forms and applications. These are deliberately
  // separate from the placement-specific Application model below.
  createdForms                       Form[]                       @relation("FormCreatedBy")
  formSubmissions                    FormSubmission[]             @relation("FormSubmissionApplicant")
  formApplicationReviewerAssignments FormApplicationReviewer[]    @relation("FormApplicationReviewer")
  formApplicationReviewAssignments   FormApplicationReviewer[]    @relation("FormApplicationReviewerAssignedBy")
  formApplicationReviews             FormApplicationReview[]      @relation("FormApplicationReviewReviewer")
  formApplicationStatusChanges       FormApplicationStatusEvent[] @relation("FormApplicationStatusChangedBy")
  formApplicationDecisions           FormApplication[]            @relation("FormApplicationDecidedBy")

  coreCommitteeSelectionsCreated              CoreCommitteeSelection[]                  @relation("CoreCommitteeSelectionCreator")
  coreCommitteeSelectionsLocked               CoreCommitteeSelection[]                  @relation("CoreCommitteeSelectionLocker")
  coreCommitteeSelectionCandidates            CoreCommitteeSelectionCandidate[]         @relation("CoreCommitteeSelectionCandidateApplicant")
  coreCommitteeSelectionScrutinyReviews       CoreCommitteeSelectionScrutinyReview[]    @relation("CoreCommitteeSelectionScrutinyReviewer")
  coreCommitteeSelectionCorrectionRequests    CoreCommitteeSelectionCorrectionRequest[] @relation("CoreCommitteeSelectionCorrectionRequester")
  coreCommitteeSelectionCorrectionSubmissions CoreCommitteeSelectionCorrectionRequest[] @relation("CoreCommitteeSelectionCorrectionSubmitter")
  coreCommitteeSelectionShortlistEntries      CoreCommitteeSelectionShortlistEntry[]    @relation("CoreCommitteeSelectionShortlistedBy")
  coreCommitteeSelectionInterviews            CoreCommitteeSelectionInterview[]         @relation("CoreCommitteeSelectionInterviewScheduler")
  coreCommitteeSelectionCancelledInterviews   CoreCommitteeSelectionInterview[]         @relation("CoreCommitteeSelectionInterviewCanceller")
  coreCommitteeCouncilReviews                 CoreCommitteeCouncilReview[]              @relation("CoreCommitteeCouncilReviewMember")
  coreCommitteeSelectionDecisionsRecorded     CoreCommitteeSelectionDecision[]          @relation("CoreCommitteeSelectionDecisionRecorder")
  coreCommitteeSelectionDecisionsFinalized    CoreCommitteeSelectionDecision[]          @relation("CoreCommitteeSelectionDecisionFinalizer")
  coreCommitteeSelectionPublications          CoreCommitteeSelectionPublication[]       @relation("CoreCommitteeSelectionPublisher")
  coreCommitteeSelectionAppointmentsConfirmed CoreCommitteeSelectionAppointment[]       @relation("CoreCommitteeSelectionAppointmentConfirmer")
  coreCommitteeSelectionAppointmentsReceived  CoreCommitteeSelectionAppointment[]       @relation("CoreCommitteeSelectionAppointedUser")
  coreCommitteeSelectionDeadlineExtensions    CoreCommitteeSelectionDeadlineExtension[] @relation("CoreCommitteeSelectionDeadlineExtender")
  coreCommitteeSelectionInterviewHistory      CoreCommitteeSelectionInterviewHistory[]  @relation("CoreCommitteeSelectionInterviewHistoryActor")

  // MYARCH Edit Mode — inline content overrides for existing public pages.
  updatedContentOverrides ContentOverride[] @relation("ContentOverrideUpdatedBy")

  @@map("users")
}

// A refresh token is stored server-side (hashed) so it can be individually
// revoked/rotated per docs/security/14_Security_Architecture.md. The raw
// token is never persisted — only a hash of it.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// MYARCH Phase 1: proves control of an email address before either (a) an
// existing User's email is considered verified (RECRUITER/ALUMNI self-
// signup — `userId` populated), or (b) a RegistrationRequest is eligible
// for Secretary decision (STUDENT — no User exists yet at signup time, so
// `registrationRequestId` is populated instead). Exactly one of the two FKs
// is set per row; both are nullable because the same shape serves both
// cases rather than three near-duplicate token tables. Single-use: consumed
// by setting `consumedAt`, never deleted (mirrors RefreshToken's audit-
// trail-over-deletion convention). Raw token is never persisted — only a
// hash of it (see src/lib/opaque-token.ts), matching RefreshToken's own
// `tokenHash` convention exactly.
model EmailVerificationToken {
  id        String @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String @unique

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationRequestId String?              @db.Uuid
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

// MYARCH Phase 1: forgot-password. Always User-bound (a password can only
// ever be reset for an account that already exists) — unlike
// EmailVerificationToken, no dual-purpose shape is needed here. Same
// single-use/audit-trail/hashed-token conventions as RefreshToken.
model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model SecretaryProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String

  @@map("secretary_profiles")
}

model CoordinatorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  // V3.0: mirrors StudentProfile.isActive exactly — flipped alongside
  // User.isActive in one $transaction (see PrismaStudentRepository.setActive
  // for the template). "Disable" and "Delete (soft delete)" are the same
  // toggle, not two independent states.
  isActive Boolean              @default(true)
  // V4.0 (A1) + MYARCH unified Coordinator Position — display/reporting label
  // only, see CoordinatorPosition's own doc comment.
  position CoordinatorPosition?

  // Free-text label, meaningful only when position = OTHER (e.g. "Cultural
  // Coordinator") — null/ignored for every other position value. Descriptive
  // only; no permission function ever reads it.
  customPosition String?

  // MYARCH — Maintenance functional hierarchy (see MaintenanceCoordinatorRole's
  // own doc comment). Null for every ordinary Coordinator (the overwhelming
  // majority) — only set via SetCoordinatorMaintenanceRoleUseCase
  // (Technical-Secretary-only, same gate as every other Coordinator-account
  // management action), never directly.
  maintenanceRole MaintenanceCoordinatorRole?

  // MYARCH Phase 1: granular capabilities the Technical Secretary has
  // delegated to this Coordinator (roadmap §2.3 — e.g. "maintenance.view",
  // "events.create"). A flat string array, validated at the application
  // layer against COORDINATOR_PERMISSION_KEYS (src/modules/coordinators/domain/permissions.ts)
  // rather than a join table — matches this schema's existing convention
  // for small tag-like sets (StudentPublicProfile.skills/software), and
  // avoids a relational table for what is structurally a set-membership
  // check, not a queryable relation. The Technical Secretary (SECRETARY
  // role) always implicitly has every capability regardless of this array —
  // see hasCoordinatorPermission's own doc comment. Most of the named keys
  // in §2.3 have no backing feature yet (maintenance/events/etc. don't
  // exist until later roadmap phases) — this column stores the grant
  // itself, which is real and functional (audited, Secretary-editable,
  // visible on the Coordinator's own record) even before a later phase's
  // module has anything to check it against.
  permissions String[] @default([])

  batchScopes CoordinatorBatchScope[]

  @@map("coordinator_profiles")
}

// Join table enforcing that Coordinator authority is explicit and additive,
// never global by default — see docs/security/09_User_Roles_and_Permissions.md.
model CoordinatorBatchScope {
  id                   String             @id @default(uuid()) @db.Uuid
  coordinatorProfileId String             @db.Uuid
  coordinatorProfile   CoordinatorProfile @relation(fields: [coordinatorProfileId], references: [id], onDelete: Cascade)
  batchId              String             @db.Uuid
  batch                Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@unique([coordinatorProfileId, batchId])
  @@index([batchId])
  @@map("coordinator_batch_scopes")
}

model RecruiterProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  companyName String
  // Structured Company entity + FK arrives in Phase 2 with PlacementDrive
  // (docs/database/08_Database_Design.md). companyName is a plain string for
  // Phase 1 since only directory browsing is in scope, not drive-scoped
  // self-service.

  // V3.0: mirrors StudentProfile.isActive (see CoordinatorProfile.isActive
  // doc comment — identical reasoning).
  isActive       Boolean                 @default(true)
  // Secretary-created recruiters default to APPROVED (creating one directly
  // *is* the approval). PENDING/approve/reject are real, tested actions,
  // ready for a future public recruiter-signup path that does not exist yet
  // — see the RecruiterApprovalStatus enum doc comment.
  approvalStatus RecruiterApprovalStatus @default(APPROVED)

  savedStudents    RecruiterStudentInteraction[]
  interestRequests RecruiterInterestRequest[]

  @@map("recruiter_profiles")
}

// V4.0 C1: Save + Shortlist collapsed into one row with two flags (Q3,
// §23) — a promoted-save is still the same row, never a separate
// named-collection table. Both fields are private to the recruiter; never
// visible to the student or any other recruiter (§8).
model RecruiterStudentInteraction {
  id                 String           @id @default(uuid()) @db.Uuid
  recruiterProfileId String           @db.Uuid
  recruiterProfile   RecruiterProfile @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  studentProfileId   String           @db.Uuid
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  savedAt       DateTime?
  isShortlisted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recruiterProfileId, studentProfileId])
  @@index([studentProfileId])
  @@map("recruiter_student_interactions")
}

// V4.0 C2: the unique constraint below is the mechanism that satisfies
// "prevent duplicate submissions" (§5.1) — a second Express Interest attempt
// updates/reads the same row rather than creating a new one.
model RecruiterInterestRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  recruiterProfileId String           @db.Uuid
  recruiterProfile   RecruiterProfile @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  studentProfileId   String           @db.Uuid
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  message     String?
  status      RecruiterInterestStatus @default(SENT)
  sentAt      DateTime                @default(now())
  respondedAt DateTime?
  completedAt DateTime?

  @@unique([recruiterProfileId, studentProfileId])
  @@index([studentProfileId])
  @@map("recruiter_interest_requests")
}

enum RecruiterInterestStatus {
  SENT
  ACCEPTED
  DECLINED
  COMPLETED
}

// ---------------------------------------------------------------------------
// Batches & Students
// ---------------------------------------------------------------------------

model Batch {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  year      Int
  status    BatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  students             StudentProfile[]
  coordinatorScopes    CoordinatorBatchScope[]
  bulkImportRuns       BulkImportRun[]
  registrationRequests RegistrationRequest[]

  @@map("batches")
}

model StudentProfile {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @unique @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId    String @db.Uuid
  batch      Batch  @relation(fields: [batchId], references: [id])
  rollNumber String @unique
  // Duplicated intentionally for non-sensitive identification without
  // joining into StudentPrivateProfile — see docs/database/08_Database_Design.md
  // Assumptions.
  fullName   String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V4.0 E6 (§15/§19) — Postgres-generated tsvector over fullName+rollNumber,
  // GIN-indexed, populated by the hand-written migration.sql (Prisma can't
  // express GENERATED ALWAYS AS ... STORED via the schema DSL). Read-only —
  // never written to from application code, hence Unsupported.
  searchVector Unsupported("tsvector")?

  privateProfile               StudentPrivateProfile?
  publicProfile                StudentPublicProfile?
  draft                        StudentPublicProfileDraft?
  portfolioImages              StudentPortfolioImage[]
  registrationRequest          RegistrationRequest?
  recruiterStudentInteractions RecruiterStudentInteraction[]
  recruiterInterestRequests    RecruiterInterestRequest[]
  applications                 Application[]
  formSubmissions              FormSubmission[]              @relation("FormSubmissionStudent")
  alumniProfile                AlumniProfile?

  @@index([batchId])
  @@map("student_profiles")
}

// Accessible only to: the student themself, Secretary, and Coordinators
// scoped to the student's batch. Never reachable from any Recruiter-facing
// query path — see docs/security/14_Security_Architecture.md.
model StudentPrivateProfile {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @unique @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  phone            String?
  personalEmail    String?
  cgpa             Decimal? @db.Decimal(4, 2)
  hasActiveBacklog Boolean  @default(false)
  backlogDetails   String?
  internalRemarks  String?

  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid
  updatedBy       User?    @relation("PrivateProfileUpdatedBy", fields: [updatedByUserId], references: [id])

  confidentialDocuments FileAsset[] @relation("ConfidentialDocumentsOf")

  @@map("student_private_profiles")
}

// The only table any Recruiter-facing query is permitted to read from.
model StudentPublicProfile {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @unique @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  bio              String?
  skills           String[]   @default([])
  software         String[]   @default([])
  selectedProjects Json       @default("[]")
  portfolioLinks   String[]   @default([])
  resumeFileId     String?    @db.Uuid
  resumeFile       FileAsset? @relation("PublicResumeOf", fields: [resumeFileId], references: [id])
  certifications   Json       @default("[]")
  internships      Json       @default("[]")

  // V4.0 B4: the concrete implementation of "students control visibility of
  // sensitive information" (§7). isPubliclyDiscoverable gates appearing in
  // the public directory at all; showCgpa is a narrow, separate opt-in for
  // the single CGPA value — enforced server-side in the public repository's
  // query/projection only, never trusted from a client parameter (§18.2).
  isPubliclyDiscoverable Boolean @default(true)
  showCgpa               Boolean @default(false)

  publishedFromDraftId String?                    @unique @db.Uuid
  publishedFromDraft   StudentPublicProfileDraft? @relation("PublishedFrom", fields: [publishedFromDraftId], references: [id])
  publishedAt          DateTime                   @default(now())
  publishedByUserId    String                     @db.Uuid
  publishedBy          User                       @relation("ProfilePublishedBy", fields: [publishedByUserId], references: [id])
  portfolioImages      StudentPortfolioImage[]    @relation("PublishedPortfolioImages")

  @@map("student_public_profiles")
}

// Where a student's in-progress edits live. Never read by any Recruiter-facing
// code path — see docs/architecture/05_System_Architecture.md's Core Data Flow.
model StudentPublicProfileDraft {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @unique @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  bio              String?
  skills           String[]   @default([])
  software         String[]   @default([])
  selectedProjects Json       @default("[]")
  portfolioLinks   String[]   @default([])
  resumeFileId     String?    @db.Uuid
  resumeFile       FileAsset? @relation("DraftResumeOf", fields: [resumeFileId], references: [id])
  certifications   Json       @default("[]")
  internships      Json       @default("[]")

  status           ProfileDraftStatus @default(DRAFT)
  submittedAt      DateTime?
  reviewedByUserId String?            @db.Uuid
  reviewedBy       User?              @relation("DraftReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedAs StudentPublicProfile? @relation("PublishedFrom")
  portfolioImages StudentPortfolioImage[] @relation("DraftPortfolioImages")

  @@map("student_public_profile_drafts")
}

// V4.0 B1: the public, unauthenticated entry point into the platform — no
// User/StudentProfile exists until a Secretary approves this (§7 step 2–4,
// §24 "Public Registration must NOT create active accounts before Secretary
// approval"). submittedData holds self-reported contact fields (phone,
// personal email, notes) kept separate from StudentPrivateProfile until
// approval, matching the PRD's field list (§5.1).
model RegistrationRequest {
  id            String                    @id @default(uuid()) @db.Uuid
  email         String
  fullName      String
  rollNumber    String
  batchId       String                    @db.Uuid
  batch         Batch                     @relation(fields: [batchId], references: [id])
  submittedData Json                      @default("{}")
  status        RegistrationRequestStatus @default(SUBMITTED)

  // MYARCH Phase 1: null until the applicant clicks the link from their
  // EmailVerificationToken. DecideRegistrationRequestUseCase refuses to
  // APPROVE (create the real account) while this is null — the existing
  // submit → Coordinator-review → Secretary-decide pipeline is otherwise
  // completely unchanged; this is an added precondition on the final step,
  // not a new pipeline.
  emailVerifiedAt DateTime?

  emailVerificationTokens EmailVerificationToken[]

  coordinatorComment String?
  reviewedByUserId   String?   @db.Uuid
  reviewedBy         User?     @relation("RegistrationRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt         DateTime?

  decidedByUserId String?   @db.Uuid
  decidedBy       User?     @relation("RegistrationRequestDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  rejectionReason String?

  resultingStudentProfileId String?         @unique @db.Uuid
  resultingStudentProfile   StudentProfile? @relation(fields: [resultingStudentProfileId], references: [id])
  credentialsEmailSent     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@map("registration_requests")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model FileAsset {
  id             String             @id @default(uuid()) @db.Uuid
  ownerUserId    String             @db.Uuid
  owner          User               @relation("FileOwner", fields: [ownerUserId], references: [id])
  storageKey     String             @unique
  mimeType       String
  sizeBytes      Int
  classification FileClassification
  createdAt      DateTime           @default(now())

  confidentialOfPrivateProfileId String?                @db.Uuid
  confidentialOfPrivateProfile   StudentPrivateProfile? @relation("ConfidentialDocumentsOf", fields: [confidentialOfPrivateProfileId], references: [id])

  usedAsPublicResume             StudentPublicProfile[]      @relation("PublicResumeOf")
  usedAsDraftResume              StudentPublicProfileDraft[] @relation("DraftResumeOf")
  usedAsAvatarOf                 User?                       @relation("UserAvatar")
  usedAsLogoOf                   Company?                    @relation("CompanyLogo")
  usedAsCertificateOf            InternshipOutcome?          @relation("InternshipCertificate")
  usedAsTemplateThumbnailOf      PublicationTemplate?        @relation("PublicationTemplateThumbnail")
  usedAsPublicationExportOf      PublicationExport?          @relation("PublicationExportFile")
  usedAsMaintenanceAttachmentOf  MaintenanceAttachment[]     @relation("MaintenanceAttachmentFile")
  usedAsRequestAttachmentOf      RequestAttachment[]         @relation("RequestAttachmentFile")
  usedAsEventAttachmentOf        EventAttachment[]           @relation("EventAttachmentFile")
  usedAsEventCoverImageOf        Event[]                     @relation("EventCoverImage")
  usedAsEventGalleryImageOf      EventGalleryItem[]          @relation("EventGalleryImage")
  usedAsAnnouncementAttachmentOf AnnouncementAttachment[]    @relation("AnnouncementAttachmentFile")
  usedAsCommitteeAttachmentOf    CommitteeAttachment[]       @relation("CommitteeAttachmentFile")
  usedAsContentOverrideOf        ContentOverride[]           @relation("ContentOverrideFile")
  usedAsContentOverrideDraftOf   ContentOverride[]           @relation("ContentOverrideDraftFile")
  usedAsPortfolioImageOf         StudentPortfolioImage?      @relation("PortfolioImageFile")

  @@index([ownerUserId])
  @@map("file_assets")
}

model StudentPortfolioImage {
  id                 String                     @id @default(uuid()) @db.Uuid
  studentProfileId   String                     @db.Uuid
  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileId             String                     @unique @db.Uuid
  file               FileAsset                  @relation("PortfolioImageFile", fields: [fileId], references: [id], onDelete: Cascade)
  draftId            String?                    @db.Uuid
  draft              StudentPublicProfileDraft? @relation("DraftPortfolioImages", fields: [draftId], references: [id], onDelete: SetNull)
  publishedProfileId String?                    @db.Uuid
  publishedProfile   StudentPublicProfile?      @relation("PublishedPortfolioImages", fields: [publishedProfileId], references: [id], onDelete: SetNull)
  title              String?
  caption            String?
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now())

  @@index([studentProfileId])
  @@index([draftId, sortOrder])
  @@index([publishedProfileId, sortOrder])
  @@map("student_portfolio_images")
}

// ---------------------------------------------------------------------------
// Placement Pipeline (V4.0 A4 — Company only; PlacementDrive/Application
// arrive with Phase D, per docs/planning/V4_0_PRD.md §17)
// ---------------------------------------------------------------------------

// V4.0 A4: the directory record docs/database/08_Database_Design.md
// pre-designed as a "Phase 2" entity — a pure directory record, not a
// login-capable entity (RecruiterProfile still authenticates as an
// individual; see §24 Q5). Secretary-managed, Coordinator-viewable (§4).
// RecruiterProfile.companyName → companyId FK migration is deliberately
// deferred to Phase C, where /recruiter/company first needs it — wiring it
// now would be a schema change with no consumer yet.
model Company {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  sector  String?
  website String?

  logoFileId String?    @unique @db.Uuid
  logoFile   FileAsset? @relation("CompanyLogo", fields: [logoFileId], references: [id])

  // Mirrors CoordinatorProfile.isActive/RecruiterProfile.isActive — the
  // same "disable is soft delete" pattern used everywhere else in the app.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V4.0 E6 — see StudentProfile.searchVector's doc comment; same pattern, over `name`.
  searchVector Unsupported("tsvector")?

  placementDrives PlacementDrive[]

  @@index([name])
  @@map("companies")
}

enum PlacementDriveType {
  PLACEMENT
  INTERNSHIP
}

enum PlacementDriveStatus {
  DRAFT
  ANNOUNCED
  IN_PROGRESS
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
  ACTIVE
  COMPLETED
  WITHDRAWN
}

// V4.0 D1 (§0, §5.1, §11) — Internships are a `type` variant of this same
// model, never a parallel entity tree ("data entered once, reused
// everywhere" — explicitly approved over a separate Internship entity).
model PlacementDrive {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @db.Uuid
  company   Company            @relation(fields: [companyId], references: [id])
  title     String
  type      PlacementDriveType

  // { minCgpa?: number, backlogAllowance?: boolean, eligibleBatchIds: string[] }
  eligibility         Json
  packageOrStipend    String?
  description         String?
  status              PlacementDriveStatus @default(DRAFT)
  applicationDeadline DateTime?

  createdByUserId String @db.Uuid
  createdBy       User   @relation("PlacementDriveCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V4.0 E6 — see StudentProfile.searchVector's doc comment; same pattern, over `title`.
  searchVector Unsupported("tsvector")?

  applications Application[]

  @@index([companyId])
  @@index([status])
  @@map("placement_drives")
}

// V4.0 D1 (§5.1, §11) — currentStatus walks APPLIED → SHORTLISTED →
// INTERVIEW → OFFER → ACCEPTED (placement), or for an INTERNSHIP drive
// continues ACCEPTED → ACTIVE → COMPLETED. REJECTED/WITHDRAWN are terminal
// exits from any non-terminal state. One row per student per drive — the
// unique constraint is the "prevent duplicate applications" mechanism,
// mirroring RecruiterInterestRequest's own unique-constraint precedent.
model Application {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  placementDriveId String         @db.Uuid
  placementDrive   PlacementDrive @relation(fields: [placementDriveId], references: [id], onDelete: Cascade)

  currentStatus ApplicationStatus @default(APPLIED)
  currentRound  Int?

  // V4.0 D3 (§14, §18) — "simple date/time/mode fields on Application, no
  // calendar-sync integration." Both nullable: an interview only exists
  // once a Secretary/Coordinator schedules one, and either can be
  // rescheduled by setting them again.
  interviewScheduledAt DateTime?
  interviewMode        InterviewMode?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents      ApplicationStatusEvent[]
  internshipOutcome InternshipOutcome?

  @@unique([studentProfileId, placementDriveId])
  @@index([placementDriveId])
  @@index([studentProfileId])
  @@map("applications")
}

// V4.0 D4 (§5.1) — "the internship-specific tail end of the lifecycle, kept
// OFF Application itself so a placement Application never carries
// irrelevant certificate/feedback columns." One row per Application, only
// ever created once the application reaches ACTIVE on an INTERNSHIP drive.
model InternshipOutcome {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @unique @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  certificateFileId String?    @unique @db.Uuid
  certificateFile   FileAsset? @relation("InternshipCertificate", fields: [certificateFileId], references: [id])

  companyFeedback String?
  studentFeedback String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("internship_outcomes")
}

enum InterviewMode {
  ONLINE
  IN_PERSON
  PHONE
}

// V4.0 D5 (§5.1) — "Manage alumni records: Coordinator Full (operational),
// Secretary Full" (§4's permission matrix — the one entity in this PRD
// where both roles have byte-for-byte identical CRUD authority, no
// approve/decide split). studentProfileId is nullable for rare
// pre-platform alumni with no StudentProfile row at all.
model AlumniProfile {
  id               String          @id @default(uuid()) @db.Uuid
  studentProfileId String?         @unique @db.Uuid
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])

  // MYARCH Phase 1: nullable — existing directory-only records (created via
  // the admin CRUD in src/modules/alumni, no self-signup involved) have no
  // login account and never will unless someone later signs up with that
  // exact email. Populated only by SignupAlumniUseCase.
  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  graduationYear      Int
  currentCompany      String?
  designation         String?
  location            String?
  portfolioUrl        String?
  linkedInUrl         String?
  mentorshipAvailable Boolean @default(false)

  // MYARCH Phase 1: reuses RecruiterApprovalStatus rather than a duplicate
  // three-value enum (PENDING/APPROVED/REJECTED means the same thing here
  // as it does for a self-signed-up Recruiter). Defaults APPROVED so every
  // existing admin-created directory row (and any future admin-created row)
  // is unaffected — only SignupAlumniUseCase ever creates a PENDING row,
  // mirroring CreateRecruiterAccountUseCase/SignupRecruiterUseCase's exact
  // split.
  approvalStatus RecruiterApprovalStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([graduationYear])
  @@map("alumni_profiles")
}

// ---------------------------------------------------------------------------
// Generic Forms and Applications (MYARCH Phase 5)
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FormFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  DROPDOWN
  RADIO
  CHECKBOX
  DATE
}

enum FormApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SELECTED
  REJECTED
}

model Form {
  electionApplicationForm               ElectionApplicationForm?
  coreCommitteeSelectionApplicationForm CoreCommitteeSelectionApplicationForm?
  id                                    String                                 @id @default(uuid()) @db.Uuid
  title                                 String
  description                           String?
  status                                FormStatus                             @default(DRAFT)
  deadline                              DateTime?

  committeeId String?    @db.Uuid
  committee   Committee? @relation(fields: [committeeId], references: [id])

  createdByUserId String @db.Uuid
  createdBy       User   @relation("FormCreatedBy", fields: [createdByUserId], references: [id])

  publishedAt DateTime?
  closedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
  eventLinks  EventForm[]

  @@index([status])
  @@index([committeeId])
  @@map("forms")
}

model FormField {
  id           String        @id @default(uuid()) @db.Uuid
  formId       String        @db.Uuid
  form         Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  key          String
  label        String
  type         FormFieldType
  description  String?
  required     Boolean       @default(false)
  options      Json?
  validation   Json?
  displayOrder Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([formId, key])
  @@index([formId, displayOrder])
  @@map("form_fields")
}

model FormSubmission {
  id               String         @id @default(uuid()) @db.Uuid
  formId           String         @db.Uuid
  form             Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  applicantUserId  String         @db.Uuid
  applicant        User           @relation("FormSubmissionApplicant", fields: [applicantUserId], references: [id])
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation("FormSubmissionStudent", fields: [studentProfileId], references: [id])
  answers          Json
  submittedAt      DateTime       @default(now())
  createdAt        DateTime       @default(now())

  application FormApplication?

  @@unique([formId, applicantUserId])
  @@index([applicantUserId])
  @@index([studentProfileId])
  @@map("form_submissions")
}

model FormApplication {
  electionCandidate               ElectionCandidate?
  coreCommitteeSelectionCandidate CoreCommitteeSelectionCandidate?
  id                              String                           @id @default(uuid()) @db.Uuid
  submissionId                    String                           @unique @db.Uuid
  submission                      FormSubmission                   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  currentStatus                   FormApplicationStatus            @default(SUBMITTED)
  decisionReason                  String?
  decidedByUserId                 String?                          @db.Uuid
  decidedBy                       User?                            @relation("FormApplicationDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt                       DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt

  reviewers    FormApplicationReviewer[]
  reviews      FormApplicationReview[]
  statusEvents FormApplicationStatusEvent[]

  @@index([currentStatus])
  @@map("form_applications")
}

model FormApplicationReviewer {
  id               String          @id @default(uuid()) @db.Uuid
  applicationId    String          @db.Uuid
  application      FormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerUserId   String          @db.Uuid
  reviewer         User            @relation("FormApplicationReviewer", fields: [reviewerUserId], references: [id])
  assignedByUserId String          @db.Uuid
  assignedBy       User            @relation("FormApplicationReviewerAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime        @default(now())
  unassignedAt     DateTime?

  @@index([applicationId])
  @@index([reviewerUserId, unassignedAt])
  @@map("form_application_reviewers")
}

model FormApplicationReview {
  id             String          @id @default(uuid()) @db.Uuid
  applicationId  String          @db.Uuid
  application    FormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerUserId String          @db.Uuid
  reviewer       User            @relation("FormApplicationReviewReviewer", fields: [reviewerUserId], references: [id])
  notes          String
  createdAt      DateTime        @default(now())

  @@index([applicationId])
  @@index([reviewerUserId])
  @@map("form_application_reviews")
}

model FormApplicationStatusEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  applicationId   String                 @db.Uuid
  application     FormApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus      FormApplicationStatus?
  toStatus        FormApplicationStatus
  note            String?
  changedByUserId String                 @db.Uuid
  changedBy       User                   @relation("FormApplicationStatusChangedBy", fields: [changedByUserId], references: [id])
  occurredAt      DateTime               @default(now())

  @@index([applicationId])
  @@map("form_application_status_events")
}

// V4.0 D1 (§5.1, §11) — append-only audit trail of status changes, never
// mutated in place, directly mirroring the existing AuditLog pattern.
model ApplicationStatusEvent {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  note       String?

  changedByUserId String @db.Uuid
  changedBy       User   @relation("ApplicationStatusChangedBy", fields: [changedByUserId], references: [id])

  occurredAt DateTime @default(now())

  @@index([applicationId])
  @@map("application_status_events")
}

// ---------------------------------------------------------------------------
// Cross-cutting: Audit, Notifications, Background Jobs
// ---------------------------------------------------------------------------

// Append-only. No update/delete path is exposed by the application layer —
// see docs/security/14_Security_Architecture.md.
model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actorUserId      String   @db.Uuid
  actor            User     @relation("AuditActor", fields: [actorUserId], references: [id])
  action           String
  targetEntityType String
  targetEntityId   String   @db.Uuid
  metadata         Json     @default("{}")
  occurredAt       DateTime @default(now())

  @@index([actorUserId])
  @@index([targetEntityType, targetEntityId])
  @@map("audit_logs")
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  recipientUserId String              @db.Uuid
  recipient       User                @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  channel         NotificationChannel @default(EMAIL)
  template        String
  status          NotificationStatus  @default(PENDING)
  payload         Json                @default("{}")
  createdAt       DateTime            @default(now())
  sentAt          DateTime?
  // V4.0 E1 — set when the recipient dismisses/opens an IN_APP row in the
  // notification center. Unused (always null) for EMAIL rows.
  readAt          DateTime?

  @@index([recipientUserId])
  @@map("notifications")
}

// Generic background job queue backing the Background Job Processing
// System (2026-08-05). `type` is a free-form string, deliberately not an
// enum — new job types are added by other modules registering a handler,
// never by changing this schema (see src/modules/jobs).
model Job {
  id      String    @id @default(uuid()) @db.Uuid
  type    String
  payload Json      @default("{}")
  status  JobStatus @default(PENDING)

  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  runAt           DateTime  @default(now())
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  completedAt     DateTime?
  errorMessage    String?
  // Milliseconds. Recorded for both successful and failed attempts.
  executionTimeMs Int?
  // Worker id that currently holds this job (set atomically by the claim
  // query alongside status=PROCESSING; cleared on completion/failure/retry).
  // Not a distributed lock by itself — the atomic claim (status transition
  // + FOR UPDATE SKIP LOCKED) is what prevents double-claiming; this field
  // exists for observability (which worker is/was handling this job).
  lockedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// MYARCH Phase 2 (§3.8) — Task / Follow-up Engine. Reusable infrastructure:
// every future domain the roadmap names (maintenance, generic requests,
// events, meetings, applications, interviews, elections, projects) is
// expected to create rows here via relatedEntityType/relatedEntityId rather
// than building its own task/assignment/deadline/escalation system — the
// same FK-less polymorphic-reference shape AuditLog.targetEntityType/
// targetEntityId already established, reused rather than reinvented.
// Reminder/overdue-detection/escalation ride the existing Background Job
// Processing System (Job model above) via one-shot scheduled jobs — see
// src/modules/tasks's job handlers — rather than a second scheduler.
// ---------------------------------------------------------------------------

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  ownerId   String @db.Uuid
  owner     User   @relation("TaskOwner", fields: [ownerId], references: [id])
  creatorId String @db.Uuid
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  deadline   DateTime?
  reminderAt DateTime?

  escalatedAt   DateTime?
  escalatedToId String?   @db.Uuid
  escalatedTo   User?     @relation("TaskEscalatedTo", fields: [escalatedToId], references: [id])

  // Polymorphic link to the future domain entity this task belongs to (a
  // maintenance issue, an application, an election, ...) — FK-less by
  // design, mirroring AuditLog above; a Task with both fields null is a
  // standalone to-do with no owning domain entity.
  relatedEntityType String?
  relatedEntityId   String? @db.Uuid

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]

  @@index([ownerId])
  @@index([creatorId])
  @@index([status])
  @@index([deadline])
  @@index([relatedEntityType, relatedEntityId])
  @@map("tasks")
}

model TaskComment {
  id       String @id @default(uuid()) @db.Uuid
  taskId   String @db.Uuid
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  author   User   @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// MYARCH Phase 2 (§3.1–§3.7) — Maintenance & Generic Requests, built on top
// of the Task Engine above. Neither model gets its own reminder/escalation/
// comment system: once a MaintenanceIssue/Request is assigned, a single Task
// row is created (owner = assignee, relatedEntityType/relatedEntityId
// pointing back here) and every SLA/deadline/reminder/overdue-detection/
// escalation/update-comment need is served by the EXISTING Task Engine
// unchanged. `taskId` below is a plain, FK-less pointer to that Task —
// mirrors Task.relatedEntityId's own already-established "polymorphic
// cross-domain reference = plain column, no enforced FK" convention; the
// Task Engine itself never needs to know either of these models exist.
// ---------------------------------------------------------------------------

model MaintenanceIssue {
  id          String                 @id @default(uuid()) @db.Uuid
  category    MaintenanceCategory
  location    String
  description String
  priority    TaskPriority           @default(MEDIUM)
  status      MaintenanceIssueStatus @default(SUBMITTED)

  // Nullable — MYARCH public Maintenance reporting amendment. Null means
  // this issue was reported anonymously via the public, unauthenticated
  // /maintenance/report flow (ReportPublicMaintenanceIssueUseCase); in that
  // case publicReporterName/publicReporterEmail carry the complainant's
  // contact info instead. Never both null and unset — exactly one of
  // {requesterId} or {publicReporterName + publicReporterEmail} is present,
  // enforced at the application layer (no DB constraint expresses an XOR).
  requesterId         String? @db.Uuid
  requester           User?   @relation("MaintenanceIssueRequester", fields: [requesterId], references: [id])
  // Meaningful only when requesterId is null — the anonymous complainant's
  // own name/email, collected once at submission time. Never used for
  // authorization (an anonymous complainant has no session to authorize
  // with); staff-visible only, for contacting them about their report.
  publicReporterName  String?
  publicReporterEmail String?
  assigneeId          String? @db.Uuid
  assignee            User?   @relation("MaintenanceIssueAssignee", fields: [assigneeId], references: [id])

  // SLA deadline — mirrored onto the linked Task's own `deadline` at
  // assignment time so the Task Engine's existing overdue/escalation job
  // handles it; kept here too for display and dashboard aggregation without
  // an extra join.
  deadline DateTime?
  taskId   String?   @unique @db.Uuid

  resolutionDetails String?
  // Used for the dashboard's "average response time" (acknowledgedAt -
  // createdAt) and "average resolution time" (resolvedAt - createdAt)
  // metrics — the only two lifecycle timestamps besides createdAt/updatedAt
  // worth a dedicated column; the full stage-by-stage history is served by
  // the existing AuditLog (targetEntityType "MaintenanceIssue"), not
  // duplicated here.
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MaintenanceAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([category])
  @@map("maintenance_issues")
}

model MaintenanceAttachment {
  id        String           @id @default(uuid()) @db.Uuid
  issueId   String           @db.Uuid
  issue     MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileId    String           @db.Uuid
  file      FileAsset        @relation("MaintenanceAttachmentFile", fields: [fileId], references: [id])
  createdAt DateTime         @default(now())

  @@index([issueId])
  @@map("maintenance_attachments")
}

model Request {
  id          String        @id @default(uuid()) @db.Uuid
  type        String
  description String
  priority    TaskPriority  @default(MEDIUM)
  status      RequestStatus @default(SUBMITTED)

  requesterId String  @db.Uuid
  requester   User    @relation("RequestRequester", fields: [requesterId], references: [id])
  ownerId     String? @db.Uuid
  owner       User?   @relation("RequestOwner", fields: [ownerId], references: [id])

  deadline DateTime?
  taskId   String?   @unique @db.Uuid

  decision       RequestDecision?
  decisionReason String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments RequestAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([ownerId])
  @@map("requests")
}

model RequestAttachment {
  id        String    @id @default(uuid()) @db.Uuid
  requestId String    @db.Uuid
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String    @db.Uuid
  file      FileAsset @relation("RequestAttachmentFile", fields: [fileId], references: [id])
  createdAt DateTime  @default(now())

  @@index([requestId])
  @@map("request_attachments")
}

// ---------------------------------------------------------------------------
// MYARCH Phase 3 (§4.1–§4.5) — Calendar, Events & Meetings.
//
// There is deliberately no `CalendarEvent`/`CalendarEntry` table: the
// Central Activity Calendar (§4.1) is a pure read-time AGGREGATION over
// each owning domain's own dated rows (Event.startAt, Meeting.startAt, ...)
// — see src/modules/calendar's own module doc comment for the full
// reasoning (mirrors how Task/Follow-up Engine is the one reusable
// "work item" primitive; Calendar is the one reusable "occurrence in time"
// query surface, not a duplicated data store).
//
// Event/Meeting "tasks" and "action items" are Task Engine rows
// (relatedEntityType "Event"/"Meeting") — no separate task table here
// either, per §4.3's/§4.4's own explicit instruction to reuse the shared
// task/follow-up system.
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  slug        String      @unique
  description String?
  shortDescription String?
  category    String?
  isPublic    Boolean     @default(false)
  featured    Boolean     @default(false)
  startAt     DateTime
  endAt       DateTime?
  venue       String?
  status      EventStatus @default(DRAFT)

  organizerId String @db.Uuid
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])

  budgetAmount Decimal? @db.Decimal(10, 2)
  budgetNotes  String?

  postEventReport String?

  coverImageFileId String?    @db.Uuid
  coverImage       FileAsset? @relation("EventCoverImage", fields: [coverImageFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants  EventParticipant[]
  checklist     EventChecklistItem[]
  attachments   EventAttachment[]
  registrations EventRegistration[]
  gallery       EventGalleryItem[]
  formLinks     EventForm[]
  announcementLinks EventAnnouncement[]

  @@index([status])
  @@index([startAt])
  @@index([organizerId])
  @@index([isPublic, startAt])
  @@index([category])
  @@map("events")
}

model EventGalleryItem {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileId          String    @db.Uuid
  file            FileAsset @relation("EventGalleryImage", fields: [fileId], references: [id], onDelete: Restrict)
  caption         String?
  displayOrder    Int       @default(0)
  uploadedByUserId String   @db.Uuid
  uploadedBy      User      @relation("EventGalleryUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())

  @@unique([eventId, fileId])
  @@index([eventId, displayOrder])
  @@map("event_gallery_items")
}

model EventForm {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @db.Uuid
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formId    String        @db.Uuid
  form      Form          @relation(fields: [formId], references: [id], onDelete: Restrict)
  kind      EventFormKind @default(OTHER)
  createdAt DateTime      @default(now())

  @@unique([eventId, formId])
  @@index([formId])
  @@map("event_forms")
}

model EventAnnouncement {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @db.Uuid
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([eventId, announcementId])
  @@index([announcementId])
  @@map("event_announcements")
}

model EventParticipant {
  id      String               @id @default(uuid()) @db.Uuid
  eventId String               @db.Uuid
  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String               @db.Uuid
  user    User                 @relation("EventParticipantUser", fields: [userId], references: [id])
  role    EventParticipantRole

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

// The "checklist" bullet in §4.2, deliberately distinct from "tasks"
// (Task Engine rows): a lightweight, unowned, undated todo item — no
// assignment/deadline/priority machinery, just a label and a done flag.
model EventChecklistItem {
  id        String  @id @default(uuid()) @db.Uuid
  eventId   String  @db.Uuid
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_checklist_items")
}

// Covers both §4.2's "documents" and "media" bullets — one table, a `kind`
// discriminator, mirroring Maintenance/Request's own established
// attachment-join-table shape (FileAsset, classification PUBLIC).
model EventAttachment {
  id      String              @id @default(uuid()) @db.Uuid
  eventId String              @db.Uuid
  event   Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileId  String              @db.Uuid
  file    FileAsset           @relation("EventAttachmentFile", fields: [fileId], references: [id])
  kind    EventAttachmentKind @default(DOCUMENT)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_attachments")
}

// Covers both §4.2's "registration" and "attendance" bullets in one row —
// attendance is only ever marked for someone already registered.
model EventRegistration {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @db.Uuid
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid
  user         User      @relation("EventRegistrationUser", fields: [userId], references: [id])
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  agenda      String?
  startAt     DateTime
  venueOrLink String?
  status      MeetingStatus @default(SCHEDULED)

  organizerId String @db.Uuid
  organizer   User   @relation("MeetingOrganizer", fields: [organizerId], references: [id])

  // Post-meeting record — filled in once the meeting has happened.
  notes     String?
  decisions String?

  // MYARCH Phase 4 (§5) — Council & Committees. Nullable, additive: a meeting
  // predates this column and most meetings still have no committee (ad hoc
  // staff/student meetings). When set, this meeting shows on that committee's
  // own "Meetings" tab (queried via Meeting.search's new committeeId filter)
  // — no change to any existing meeting's behavior or to MeetingCalendarSource.
  committeeId String?    @db.Uuid
  committee   Committee? @relation(fields: [committeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MeetingParticipant[]

  @@index([status])
  @@index([startAt])
  @@index([organizerId])
  @@index([committeeId])
  @@map("meetings")
}

model MeetingParticipant {
  id        String  @id @default(uuid()) @db.Uuid
  meetingId String  @db.Uuid
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation("MeetingParticipantUser", fields: [userId], references: [id])
  attended  Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model Announcement {
  id            String                   @id @default(uuid()) @db.Uuid
  title         String
  content       String
  priority      TaskPriority             @default(MEDIUM)
  audienceType  AnnouncementAudienceType @default(EVERYONE)
  // Interpretation per audienceType: YEAR -> a batch id (as text); PROGRAM
  // -> a program/department name; COMMITTEE/COUNCIL -> reserved for Phase 4
  // (§5), free text for now since no Committee/Council table exists yet;
  // EVERYONE/COORDINATORS/SELECTED_GROUP -> unused (null) — SELECTED_GROUP's
  // actual membership lives in AnnouncementRecipient below, not here.
  audienceValue String?
  publishAt     DateTime                 @default(now())
  expiresAt     DateTime?

  authorId String @db.Uuid
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments AnnouncementAttachment[]
  recipients  AnnouncementRecipient[]
  eventLinks  EventAnnouncement[]

  @@index([publishAt])
  @@index([audienceType])
  @@map("announcements")
}

model AnnouncementAttachment {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileId         String       @db.Uuid
  file           FileAsset    @relation("AnnouncementAttachmentFile", fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([announcementId])
  @@map("announcement_attachments")
}

// Only populated when audienceType = SELECTED_GROUP — an explicit,
// arbitrary set of recipients chosen by the author, distinct from every
// other audienceType (which is resolved dynamically at send-time from
// audienceValue/role, not stored as rows).
model AnnouncementRecipient {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation("AnnouncementRecipientUser", fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_recipients")
}

// ---------------------------------------------------------------------------
// MYARCH Phase 4 (§5) — Council & Committees. Explicitly out of scope here,
// per the roadmap's own phase assignment: full Project management (Phase 7,
// §8.1) and a generic versioned Resource/Document system (also Phase 7) —
// Committee "documents" reuse the existing flat FileAsset+join-table pattern
// (CommitteeAttachment below), not a new versioned document system.
// ---------------------------------------------------------------------------

model Committee {
  id     String          @id @default(uuid()) @db.Uuid
  name   String
  type   CommitteeType
  status CommitteeStatus @default(ACTIVE)

  // Free text (e.g. "2025-2026") — no institution-wide AcademicYear model
  // exists; Batch represents a graduating student cohort, not a yearly
  // governance cycle, and doesn't fit a Student Council spanning all batches.
  academicYear String?

  // Free-text description of the group's mandate — the "responsibilities"
  // attribute from §5's own spec, at the committee/group level.
  responsibilities String?

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                        CommitteeMembership[]
  attachments                        CommitteeAttachment[]
  forms                              Form[]
  meetings                           Meeting[]
  coreCommitteeCouncilReviews        CoreCommitteeCouncilReview[]
  coreCommitteeSelectionDecisions    CoreCommitteeSelectionDecision[]
  electionAppointments               ElectionAppointment[]
  coreCommitteeSelectionAppointments CoreCommitteeSelectionAppointment[]

  @@index([type])
  @@index([status])
  @@map("committees")
}

// Never deleted — "preserve historical membership... do not destroy
// previous-year records" (§5) is implemented here exactly like Batch's own
// never-delete/status-flip precedent: a membership that ends gets isActive
// flipped false and endDate stamped, never removed.
model CommitteeMembership {
  id          String    @id @default(uuid()) @db.Uuid
  committeeId String    @db.Uuid
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation("CommitteeMembershipUser", fields: [userId], references: [id])

  // Free text (e.g. "President", "Secretary", "Member") — mirrors
  // CoordinatorProfile.customPosition's own free-text precedent; committee
  // positions are too open-ended across Council/Committee/project-team types
  // for a closed enum.
  position String?

  // Structured management-rights flag — deliberately NOT derived from the
  // free-text `position` string (matching "President" vs "Chairperson" vs
  // "Convener" would be fragile). Mirrors Meeting.organizerId's single-owner-
  // can-manage precedent, generalized to allow multiple co-leads.
  isLead Boolean @default(false)

  academicYear String?
  isActive     Boolean   @default(true)
  startDate    DateTime  @default(now())
  endDate      DateTime?

  createdAt                         DateTime                           @default(now())
  electionAppointment               ElectionAppointment?
  coreCommitteeSelectionAppointment CoreCommitteeSelectionAppointment?

  @@index([committeeId])
  @@index([userId])
  @@map("committee_memberships")
}

model CommitteeAttachment {
  id          String    @id @default(uuid()) @db.Uuid
  committeeId String    @db.Uuid
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  fileId      String    @db.Uuid
  file        FileAsset @relation("CommitteeAttachmentFile", fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([committeeId])
  @@map("committee_attachments")
}

// ---------------------------------------------------------------------------
// V3.0 Administration Platform: bulk student import & academic year rollover
// ---------------------------------------------------------------------------

// One row per bulk-CSV-import request, executed asynchronously by
// BulkImportJobHandler (src/modules/students) via the Job queue above.
// Progress/errors are tracked here rather than per-row rows in a new table —
// errorReport holds a small JSON array, matching how Job.payload already
// carries structured JSON for arbitrarily large collections elsewhere in
// this schema.
model BulkImportRun {
  id            String        @id @default(uuid()) @db.Uuid
  actorUserId   String        @db.Uuid
  actor         User          @relation("BulkImportRunActor", fields: [actorUserId], references: [id])
  batchId       String        @db.Uuid
  batch         Batch         @relation(fields: [batchId], references: [id])
  status        BulkRunStatus @default(PENDING)
  totalRows     Int           @default(0)
  processedRows Int           @default(0)
  successCount  Int           @default(0)
  failureCount  Int           @default(0)
  // { row: number, rollNumber?: string, email?: string, error: string }[] —
  // never contains generated passwords (see admin-reset-password.ts's doc
  // comment on why secrets never land in a JSON column).
  errorReport   Json          @default("[]")
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([actorUserId])
  @@index([batchId])
  @@map("bulk_import_runs")
}

// One row per Academic Year Transition Wizard run. planJson freezes exactly
// what the Secretary reviewed and confirmed — the job handler executes that
// frozen plan, never a re-computed one, so nothing changes between review
// and execution. stepLog is appended to after each step so the wizard's
// execution-progress screen can poll live status; a failed step does not
// roll back prior steps (no cross-aggregate rollback precedent exists
// anywhere else in this schema either — see PrismaStudentRepository.setActive's
// 2-write $transaction, the largest atomic unit that exists today).
model AcademicYearTransitionRun {
  id           String                       @id @default(uuid()) @db.Uuid
  actorUserId  String                       @db.Uuid
  actor        User                         @relation("AcademicYearTransitionRunActor", fields: [actorUserId], references: [id])
  status       AcademicYearTransitionStatus @default(DRAFT)
  planJson     Json
  stepLog      Json                         @default("[]")
  currentStep  String?
  createdAt    DateTime                     @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  @@index([actorUserId])
  @@map("academic_year_transition_runs")
}

// V4.0 (A2): Postgres-backed token-bucket rate limiter — one row per
// (surface, key) pair, e.g. "login:email:x@y.com" or
// "recruiter-discovery:<userId>". Deliberately DB-backed rather than
// in-process, matching the same "avoid new infrastructure at this scale"
// reasoning that put the job queue in Postgres instead of a message broker
// (see docs/planning/V4_0_PRD.md §18). See src/lib/rate-limit.ts for the
// token-bucket algorithm and src/lib/prisma-rate-limiter.ts for the
// row-locked read-refill-write that keeps concurrent requests correct.
model RateLimitBucket {
  key          String   @id
  tokens       Float
  lastRefillAt DateTime
  updatedAt    DateTime @updatedAt

  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Publication Studio (V4.0 E3 — docs/planning/V4_0_PRD.md §13, §5.1)
// Template-driven, never freeform: PublicationTemplate is a fixed skeleton of
// named block slots; Publication.contentJson is the actual block tree a
// Secretary/Coordinator edits (reorder/show-hide/edit text/swap images), never
// arbitrary positioning. PublicationVersion is an append-only snapshot
// written on every Publish, mirroring AcademicYearTransitionRun's own frozen-
// plan pattern above. PublicationExport artifacts are always generated by a
// background job (never inline in a request — see src/modules/jobs), exactly
// like every other file-producing action in this codebase.
// ---------------------------------------------------------------------------

// The ten publication kinds named in §13.1 map onto these seven storage
// categories (PublicationTemplate.name carries the specific kind — e.g. both
// "Placement Brochure" and "Department Brochure" are type=BROCHURE, distinguished
// by their own templates' structureJson/data-binding, not by a 10-value enum).
enum PublicationType {
  BROCHURE
  BOOKLET
  PORTFOLIO_BOOK
  ANNUAL_REPORT
  NEWSLETTER
  MAGAZINE
  CUSTOM
}

enum PublicationTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicationPageSize {
  A4_PORTRAIT
  A4_LANDSCAPE
  A3
  CUSTOM
}

enum PublicationExportFormat {
  PDF
  PPTX
  PNG
  JPEG
}

enum PublicationExportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// A pre-built structure with named data-binding slots — never authored by an
// end user in V4.0 (no template-builder UI; §13 explicitly starts the flow at
// "Choose Template"). Seeded once via prisma/seed.ts, one row per kind in §13.1.
model PublicationTemplate {
  id              String                    @id @default(uuid()) @db.Uuid
  name            String
  type            PublicationType
  description     String?
  thumbnailFileId String?                   @unique @db.Uuid
  thumbnailFile   FileAsset?                @relation("PublicationTemplateThumbnail", fields: [thumbnailFileId], references: [id])
  structureJson   Json
  status          PublicationTemplateStatus @default(ACTIVE)
  createdByUserId String                    @db.Uuid
  createdBy       User                      @relation("PublicationTemplateCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime                  @default(now())

  publications Publication[]

  @@index([type])
  @@map("publication_templates")
}

model Publication {
  id     String            @id @default(uuid()) @db.Uuid
  title  String
  type   PublicationType
  status PublicationStatus @default(DRAFT)

  templateId String?              @db.Uuid
  template   PublicationTemplate? @relation(fields: [templateId], references: [id])

  // The live, editable block tree — see src/modules/publications/domain/blocks.ts.
  // Data-bound blocks store only a reference id (e.g. studentProfileId), never
  // a copy of the underlying record — resolved live at preview/export time
  // (§13.1 step 2: "never copy-pasted/retyped").
  contentJson Json

  pageSize         PublicationPageSize @default(A4_PORTRAIT)
  customDimensions Json?

  // Optimistic lock (§13.4) — bumped on every save, compared on write;
  // a mismatch means someone else edited this since it was loaded.
  version Int @default(1)

  createdByUserId    String   @db.Uuid
  createdBy          User     @relation("PublicationCreatedBy", fields: [createdByUserId], references: [id])
  lastEditedByUserId String   @db.Uuid
  lastEditedBy       User     @relation("PublicationLastEditedBy", fields: [lastEditedByUserId], references: [id])
  lastEditedAt       DateTime @default(now())
  createdAt          DateTime @default(now())

  // V4.0 E6 — see StudentProfile.searchVector's doc comment; same pattern, over `title`.
  searchVector Unsupported("tsvector")?

  versions PublicationVersion[]
  exports  PublicationExport[]

  @@index([status])
  @@index([type])
  @@map("publications")
}

// Append-only — written on every Publish action (§13.4). Never updated or
// deleted; a restore creates a NEW draft state from an old snapshot, it does
// not rewrite history.
model PublicationVersion {
  id                  String      @id @default(uuid()) @db.Uuid
  publicationId       String      @db.Uuid
  publication         Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  versionNumber       Int
  contentJsonSnapshot Json
  label               String?
  createdByUserId     String      @db.Uuid
  createdBy           User        @relation("PublicationVersionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt           DateTime    @default(now())

  @@unique([publicationId, versionNumber])
  @@index([publicationId])
  @@map("publication_versions")
}

// Each export is a background-job-produced, FileAsset-backed artifact (§13.4,
// §19) — never generated inline in a request. status tracks the job's own
// progress the same way Notification.status tracks SEND_NOTIFICATION's.
model PublicationExport {
  id                String                  @id @default(uuid()) @db.Uuid
  publicationId     String                  @db.Uuid
  publication       Publication             @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  format            PublicationExportFormat
  status            PublicationExportStatus @default(PENDING)
  fileId            String?                 @unique @db.Uuid
  file              FileAsset?              @relation("PublicationExportFile", fields: [fileId], references: [id])
  errorMessage      String?
  generatedByUserId String                  @db.Uuid
  generatedBy       User                    @relation("PublicationExportGeneratedBy", fields: [generatedByUserId], references: [id])
  requestedAt       DateTime                @default(now())
  completedAt       DateTime?

  @@index([publicationId])
  @@map("publication_exports")
}

// ---------------------------------------------------------------------------
// MYARCH Edit Mode (SECRETARY-only inline content editing) — corrected
// architecture plan. The public site stays 100% developer-built React
// pages/layouts/components; this is NOT a page-builder or CMS. A single
// flat key-value table holds only the fields a Secretary has actually
// overridden — `page` + `contentKey` identify one existing piece of
// developer-authored text/image (e.g. page "about", contentKey
// "hero.title"); when no row exists, the page's own hardcoded default
// value renders, so the site is fully functional even if this table is
// empty or unreachable. No draft/publish/version distinction — a save is
// immediately live, matching "the public site simply displays the latest
// saved content." Removing an override deletes the row (reverting to the
// code-defined default) rather than storing an empty value.
// ---------------------------------------------------------------------------

enum ContentOverrideType {
  TEXT
  IMAGE
}

model ContentOverride {
  id         String              @id @default(uuid()) @db.Uuid
  page       String
  contentKey String
  type       ContentOverrideType

  // Published (live) — what every public visitor, and every non-previewing
  // Secretary, sees. Untouched by a field-level Save; only Publish writes
  // here. Exactly one of textValue/fileId is set, matching `type`.
  textValue String?
  fileId    String?    @db.Uuid
  file      FileAsset? @relation("ContentOverrideFile", fields: [fileId], references: [id])

  // Draft (pending, unpublished) — added on top of the same row rather
  // than a second table/version history (MYARCH Edit Mode draft/preview/
  // publish pass). Only ever read by the SECRETARY-only preview/summary
  // endpoints. hasDraftChange distinguishes "no pending edit" from "a
  // pending edit whose value is empty" (a staged Reset — draftTextValue/
  // draftFileId both null, but still a real pending state, not "no draft").
  hasDraftChange Boolean    @default(false)
  draftTextValue String?
  draftFileId    String?    @db.Uuid
  draftFile      FileAsset? @relation("ContentOverrideDraftFile", fields: [draftFileId], references: [id])

  updatedByUserId String   @db.Uuid
  updatedBy       User     @relation("ContentOverrideUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([page, contentKey])
  @@index([page])
  @@index([hasDraftChange])
  @@map("content_overrides")
}

